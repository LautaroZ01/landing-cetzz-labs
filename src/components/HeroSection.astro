---
import { ArrowRight } from "@lucide/astro";
import HeroIllustration from "./svg/HeroIllustration.astro";
import { getWhatsappUrl } from "../data/data";

const whatsappUrl = getWhatsappUrl(
    "Hola! Quiero mi diagnóstico gratis para mi negocio.",
);
---

<section
    id="inicio"
    class="hero-section relative z-10 bg-primary-50 w-full min-h-[95vh] text-black-900 rounded-b-[2rem] lg:rounded-b-[6rem] overflow-hidden flex items-center justify-center pt-20 pb-16 lg:pb-0 border-b border-primary-100 shadow-sm"
>
    <!-- Background Glow -->
    <div
        class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-primary-200/50 to-transparent pointer-events-none z-0"
    >
    </div>
    <div
        class="absolute -bottom-40 left-1/2 -translate-x-1/2 w-[80%] max-w-[1000px] h-[400px] bg-primary-400/40 rounded-full blur-[120px] pointer-events-none z-0"
    >
    </div>

    <div
        class="hero-inner container-labs relative z-10 flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-8 max-w-7xl w-full"
    >
        <!-- Text Content -->
        <div
            class="w-full lg:w-[50%] flex flex-col items-center lg:items-start text-center lg:text-left"
        >
            <!-- Etiqueta -->
            <p
                class="hero-offer translate-y-8 opacity-0 mb-6 text-sm font-bold uppercase tracking-widest text-primary-500"
            >
                De Salta, para pymes de todo el país
            </p>
            <h1
                class="hero-title translate-y-12 opacity-0 text-5xl md:text-4xl lg:text-[2.5rem] xl:text-[3.5rem] font-black leading-[1.1] tracking-tight text-black-900 mb-6"
            >
                Ordenamos tu negocio. <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary-600 to-[#49537e]"
                    >Después te traemos clientes.</span
                >
            </h1>

            <!-- Subtítulo -->
            <p
                class="hero-subtitle translate-y-8 opacity-0 text-lg md:text-xl text-black-600 max-w-2xl mx-auto lg:mx-0 mb-10 font-medium leading-relaxed"
            >
                Sistemas a medida, tiendas online y campañas en Meta. Un solo
                equipo que primero entiende cómo trabajás y después lo
                construye.
            </p>

            <!-- Botones -->
            <div
                class="hero-buttons translate-y-8 opacity-0 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto"
            >
                <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hero-btn hero-btn--primary w-full sm:w-auto"
                >
                    <span>Quiero mi diagnóstico gratis</span>
                    <ArrowRight class="hero-btn__icon" />
                </a>
                <a
                    href="#portafolio"
                    class="hero-btn hero-btn--secondary w-full sm:w-auto"
                >
                    <span>Ver casos reales</span>
                </a>
            </div>
            <p
                class="hero-buttons translate-y-8 opacity-0 mt-5 text-sm text-black-500 font-medium max-w-md"
            >
                30 minutos, sin costo. Te decimos qué haríamos, aunque no
                trabajes con nosotros.
            </p>
        </div>

        <!-- Hero Illustration -->
        <div
            class="hero-image translate-y-12 opacity-0 hidden lg:flex w-full lg:w-[50%] justify-center lg:justify-end mt-12 lg:mt-0"
        >
            <HeroIllustration />
        </div>
    </div>
</section>

<style>
    /* ---- Botones del Hero: hover llamativo SIN scale ni movimiento vertical ---- */
    .hero-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 1rem 2rem;
        border-radius: 0.75rem;
        font-size: 1.125rem;
        font-weight: 700;
        line-height: 1;
        overflow: hidden;
        isolation: isolate;
        transition:
            color 0.35s ease,
            border-color 0.35s ease,
            box-shadow 0.4s ease,
            background-position 0.6s ease;
    }
    .hero-btn > span,
    .hero-btn__icon {
        position: relative;
        z-index: 2;
    }
    .hero-btn__icon {
        width: 1.25rem;
        height: 1.25rem;
        transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .hero-btn:active {
        filter: brightness(0.96);
    }

    /* Primario: gradiente que fluye + destello diagonal + halo */
    .hero-btn--primary {
        color: #fff;
        background-image: linear-gradient(
            110deg,
            var(--color-primary-700) 0%,
            var(--color-primary-500) 40%,
            var(--color-primary-600) 65%,
            var(--color-primary-700) 100%
        );
        background-size: 220% 100%;
        background-position: 0% 50%;
        box-shadow: 0 10px 30px -8px rgba(37, 99, 235, 0.45);
    }
    .hero-btn--primary::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(
            100deg,
            transparent 25%,
            rgba(255, 255, 255, 0.55) 50%,
            transparent 75%
        );
        transform: translateX(-120%);
    }
    .hero-btn--primary:hover {
        background-position: 100% 50%;
        box-shadow:
            0 16px 44px -6px rgba(37, 99, 235, 0.6),
            0 0 0 4px rgba(59, 130, 246, 0.16);
    }
    .hero-btn--primary:hover::before {
        animation: hero-btn-shine 0.85s ease;
    }
    .hero-btn--primary:hover .hero-btn__icon {
        transform: translateX(6px);
    }
    @keyframes hero-btn-shine {
        to {
            transform: translateX(120%);
        }
    }

    /* Secundario: relleno de color que barre desde la izquierda + texto invertido */
    .hero-btn--secondary {
        color: var(--color-black-800);
        background-color: #fff;
        border: 1px solid var(--color-black-200);
        box-shadow: var(--shadow-soft);
    }
    .hero-btn--secondary::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        background-image: linear-gradient(
            120deg,
            var(--color-primary-600),
            var(--color-primary-500)
        );
        transform: translateX(-101%);
        transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    }
    .hero-btn--secondary:hover {
        color: #fff;
        border-color: var(--color-primary-600);
        box-shadow: 0 16px 44px -8px rgba(37, 99, 235, 0.4);
    }
    .hero-btn--secondary:hover::before {
        transform: translateX(0);
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-btn,
        .hero-btn::before,
        .hero-btn__icon {
            transition: none;
            animation: none;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { ScrollToPlugin } from "gsap/ScrollToPlugin";

    gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

    document.addEventListener("DOMContentLoaded", () => {
        const tl = gsap.timeline({ delay: 0.2 });

        // 2. Animación del Título Principal
        tl.to(
            ".hero-title",
            {
                y: 0,
                opacity: 1,
                duration: 1.2,
                ease: "power4.out",
            },
            "-=0.5",
        );

        // 3. Subtítulo
        tl.to(
            ".hero-subtitle",
            {
                y: 0,
                opacity: 1,
                duration: 1,
                ease: "power3.out",
            },
            "-=0.8",
        );

        // 3.5 Oferta
        tl.to(
            ".hero-offer",
            {
                y: 0,
                opacity: 1,
                duration: 0.8,
                ease: "back.out(1.5)",
            },
            "-=0.6",
        );

        // 4. Botones
        tl.to(
            ".hero-buttons",
            {
                y: 0,
                opacity: 1,
                duration: 0.8,
                ease: "back.out(1.5)",
            },
            "-=0.6",
        );

        // 5. Hero Image Fade-In
        tl.to(
            ".hero-image",
            {
                y: 0,
                opacity: 1,
                duration: 1.2,
                ease: "power3.out",
            },
            "-=0.8",
        );

        // 6. Animación de dibujo de la ilustración (SVG Paths)
        const drawPaths = document.querySelectorAll(".hero-draw-path");
        drawPaths.forEach((path) => {
            if (
                path instanceof SVGPathElement ||
                path instanceof SVGRectElement ||
                path instanceof SVGLineElement
            ) {
                // Approximate length for non-paths or get actual length for paths
                let length = 1000;
                if (path instanceof SVGPathElement) {
                    length = path.getTotalLength();
                }
                gsap.set(path, {
                    strokeDasharray: length,
                    strokeDashoffset: length,
                });
                tl.to(
                    path,
                    { strokeDashoffset: 0, duration: 1.2, ease: "expo.out" },
                    "-=1.0",
                );
            }
        });

        // 7. Aparición de elementos de color de la ilustración
        tl.fromTo(
            ".hero-color-block",
            { opacity: 0, scale: 0.8, transformOrigin: "center center" },
            {
                opacity: 1,
                scale: 1,
                duration: 0.5,
                stagger: 0.1,
                ease: "back.out(1.5)",
            },
            "-=1.5",
        );

        tl.fromTo(
            ".hero-fade-item",
            { opacity: 0, y: 10 },
            {
                opacity: 1,
                y: 0,
                duration: 0.6,
                stagger: 0.05,
                ease: "power2.out",
            },
            "-=1.2",
        );

        // Animaciones continuas (Loop) para las formas geométricas flotantes
        gsap.to(".hero-shape", {
            y: "random(-30, 30)",
            x: "random(-30, 30)",
            duration: 6,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
            stagger: 0.5,
        });

        gsap.to(".hero-shape-rotate", {
            rotation: 360,
            duration: 25,
            repeat: -1,
            ease: "linear",
        });

        /* ---- Transición al salir del Hero ----
           La sección siguiente queda "detrás" del Hero (ver -mt en Results),
           así que la curva inferior del Hero siempre se ve completa.
           Al hacer scroll, el contenido del Hero se aleja: se achica,
           se atenúa, se desenfoca y hace parallax, revelando lo de abajo. */
        const heroSection = document.getElementById("inicio");
        const heroInner = document.querySelector<HTMLElement>(".hero-inner");
        const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        if (!reduceMotion && heroSection && heroInner) {
            gsap.to(heroInner, {
                scale: 0.92,
                opacity: 0.2,
                yPercent: 8,
                filter: "blur(3px)",
                ease: "none",
                scrollTrigger: {
                    trigger: heroSection,
                    start: "top top",
                    end: "bottom top",
                    scrub: 0.6,
                },
            });

            /* Transición "catapulta": recién cuando llevás scrolleado el 75%
               del Hero (hacia abajo), te lleva rápido a "Resultados". */
            const results = document.getElementById("resultados");
            const isDesktop = window.matchMedia("(min-width: 1024px)").matches;
            if (results && isDesktop) {
                let jumpLock = false;
                ScrollTrigger.create({
                    trigger: heroSection,
                    start: "5% top",
                    onEnter: () => {
                        if (jumpLock) return;
                        jumpLock = true;
                        gsap.to(window, {
                            scrollTo: {
                                y: results,
                                offsetY: -96,
                                autoKill: false,
                            },
                            duration: 0.55,
                            ease: "power2.inOut",
                            onComplete: () => {
                                window.setTimeout(
                                    () => (jumpLock = false),
                                    500,
                                );
                            },
                        });
                    },
                    onLeaveBack: () => {
                        jumpLock = true;
                        window.setTimeout(() => (jumpLock = false), 800);
                    },
                });
            }
        }
    });
</script>
