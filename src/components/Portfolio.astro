---
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import Icons from "./ui/Icons.astro";
import { getWhatsappUrl } from "../data/data";

const whatsappUrl = getWhatsappUrl(
    "Hola! Vi los casos en su web. Quiero mi diagnóstico gratis para mi negocio.",
);

type Stat = { value: string; label: string };

const cases = [
    {
        id: "anitrendy",
        image: "/projects/anitrendy.webp",
        imageFit: "object-cover object-top",
        name: "Anitrendy",
        kind: "Tienda de ropa deportiva femenina",
        url: "https://anitrendy.com.ar",
        urlLabel: "anitrendy.com.ar",
        stats: [
            { value: "20,8x", label: "de retorno: cada $1 en anuncios trajo $20,8 en ventas" },
            { value: "19x", label: "más barata cada compra: de $51.286 a $2.723" },
            { value: "≈ $10 M", label: "por mes en ventas por anuncios (arrancó en $330 mil)" },
            { value: "247", label: "compras por anuncios" },
        ] as Stat[],
        quote: "",
        did: "Tienda online pensada para quien llega desde un anuncio. Campañas que siguen al stock y se escalan por etapas (Salta, NOA, Buenos Aires). En desarrollo: un sistema para que cada venta del local se descuente del stock online.",
        source: "Fuente: Meta Ads y TiendaNube, jul–nov 2026.",
    },
    {
        id: "implantes",
        image: "/projects/implantes_salud_web.webp",
        imageFit: "object-cover object-top",
        name: "Implantes Salud",
        kind: "Clínica odontológica, Salta",
        url: "https://implantessalud.com.ar",
        urlLabel: "implantessalud.com.ar",
        stats: [
            { value: "+4.500", label: "conversaciones por WhatsApp" },
            { value: "3.500", label: "trajo sola la campaña principal de implantes" },
            { value: "≈ $66", label: "por conversación en esa campaña" },
        ] as Stat[],
        quote: "Llegaron tantas consultas que la recepción no daba abasto.",
        did: "Campañas de implantes y odontología general directo a WhatsApp. Acompañamos la puesta en marcha del agente de IA de Dentalink (el agente es de Dentalink, no nuestro).",
        source: "Fuente: Meta Ads, jun–nov 2026. Son conversaciones iniciadas, no tratamientos vendidos.",
    },
];

// Evolución del retorno publicitario de Anitrendy
const evolution = [
    { value: 1.6, label: "Arranque" },
    { value: 11, label: "Campañas de compra, foco en Salta" },
    { value: 16, label: "Buenos Aires y retargeting" },
    { value: 34.7, label: "Mejor mes" },
];
const evolutionMax = Math.max(...evolution.map((e) => e.value));
const fmt = (n: number) => `${n.toLocaleString("es-AR")}x`;

const sites = [
    {
        name: "Anitrendy",
        description: "Tienda online, ropa deportiva femenina",
        url: "https://anitrendy.com.ar",
        image: "/projects/anitrendy.webp",
    },
    {
        name: "Implantes Salud",
        description: "Sitio de la clínica, con consulta directa por WhatsApp",
        url: "https://implantessalud.com.ar",
        image: "/projects/implantes_salud.png",
        imageFit: "object-contain p-6 bg-white",
    },
    {
        name: "Impacto Creativo",
        description: "Sitio institucional, agencia de marketing digital",
        url: "https://impacto-creativo.vercel.app/",
        image: "/projects/impactocreativo.webp",
    },
];

const products = [
    {
        name: "Shear",
        image: "/projects/shear.webp",
        status: "En producción · todavía en construcción",
        live: true,
        description:
            "Sistema para estéticas, con turnos, fichas de clientas y recordatorios de retoque.",
    },
    {
        name: "Saloy",
        image: "/projects/lgoosaloy.webp",
        status: "Próximamente",
        live: false,
        description:
            "Plataforma para bares donde grupos de amigos suman puntos por salir juntos y los canjean por premios.",
    },
];
---

<section
    id="portafolio"
    class="py-24 lg:py-32 bg-black-50 relative overflow-hidden"
>
    <div class="rocket-bg top-[-5%] right-[-5%] opacity-30 mix-blend-multiply">
    </div>
    <div
        class="absolute left-[-10%] w-[600px] h-[600px] bg-primary-100/90 rounded-full blur-[150px] pointer-events-none z-0"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <!-- Encabezado -->
        <div class="text-center mb-16">
            <span
                class="text-primary-500 font-bold tracking-widest uppercase text-sm mb-4 block"
                >Casos reales</span
            >
            <h2 class="section-title text-center">
                Qué hicimos y <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary-500 to-blue-600"
                    >cómo nos fue</span
                >
            </h2>
            <p class="section-subtitle mx-auto text-center">
                Con la fuente de cada dato.
            </p>
        </div>

        <!-- Casos -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
            {
                cases.map((c) => (
                    <article
                        id={`caso-${c.id}`}
                        class="case-card flex flex-col gap-6 p-8 md:p-10 bg-white border border-black-100 rounded-[2rem] shadow-sm hover:shadow-md transition-shadow"
                    >
                        <div class="aspect-[16/9] w-full overflow-hidden rounded-2xl bg-black-50 border border-black-100">
                            <img
                                src={c.image}
                                alt={`Captura o logo de ${c.name}`}
                                loading="lazy"
                                class={`w-full h-full ${c.imageFit}`}
                            />
                        </div>

                        <header class="flex flex-col gap-1">
                            <h3 class="text-3xl md:text-4xl font-extrabold text-black-900 tracking-tight">
                                {c.name}
                            </h3>
                            <p class="text-black-600 font-medium">
                                {c.kind} ·{" "}
                                <a
                                    href={c.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-primary-600 hover:underline"
                                >
                                    {c.urlLabel}
                                </a>
                            </p>
                        </header>

                        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            {c.stats.map((s) => (
                                <div class="flex flex-col gap-1 rounded-2xl bg-black-50 border border-black-100 p-4">
                                    <dt class="text-3xl font-black text-black-900 tracking-tighter">
                                        {s.value}
                                    </dt>
                                    <dd class="text-sm text-black-600 font-medium leading-snug">
                                        {s.label}
                                    </dd>
                                </div>
                            ))}
                        </dl>

                        {c.quote && (
                            <blockquote class="border-l-[3px] border-primary-500 pl-4 text-lg italic text-black-700">
                                “{c.quote}”
                            </blockquote>
                        )}

                        {c.id === "anitrendy" && (
                            <div>
                                <h4 class="text-sm font-bold uppercase tracking-wide text-black-700 mb-3">
                                    Cómo fue creciendo el retorno
                                </h4>
                                <ul class="flex flex-col gap-3">
                                    {evolution.map((e) => (
                                        <li class="grid grid-cols-[1fr_auto] gap-x-3 gap-y-1">
                                            <span class="text-sm text-black-600 font-medium">
                                                {e.label}
                                            </span>
                                            <span class="text-sm font-bold text-black-900">
                                                {fmt(e.value)}
                                            </span>
                                            <div class="col-span-2 h-2 rounded-full bg-black-100 overflow-hidden">
                                                <div
                                                    class="h-full rounded-full bg-gradient-to-r from-primary-400 to-primary-600"
                                                    style={`width: ${Math.max((e.value / evolutionMax) * 100, 3)}%`}
                                                />
                                            </div>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}

                        <div>
                            <h4 class="text-sm font-bold uppercase tracking-wide text-black-700 mb-2">
                                Qué hicimos
                            </h4>
                            <p class="text-black-600 leading-relaxed">
                                {c.did}
                            </p>
                        </div>

                        <p class="text-xs text-black-500 font-medium mt-auto">
                            {c.source}
                        </p>
                    </article>
                ))
            }
        </div>

        <!-- Sitios que hicimos -->
        <div class="mt-20">
            <h3 class="text-2xl md:text-3xl font-extrabold text-black-900 tracking-tight mb-6">
                Sitios que hicimos
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {
                    sites.map((site) => (
                        <a
                            href={site.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group flex flex-col gap-2 p-6 bg-white border border-black-100 rounded-3xl shadow-sm hover:shadow-md hover:border-primary-200 transition-all"
                        >
                            <img
                                src={site.image}
                                alt={`Imagen del sitio de ${site.name}`}
                                loading="lazy"
                                class={`w-full aspect-[16/9] rounded-2xl border border-black-100 mb-2 ${site.imageFit ?? "object-cover object-top"}`}
                            />
                            <span class="flex items-center justify-between gap-3 text-xl font-bold text-black-900">
                                {site.name}
                                <ArrowUpRight class="w-5 h-5 shrink-0 text-primary-500 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                            </span>
                            <span class="text-black-600 font-medium">
                                {site.description}
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>

        <!-- Productos propios -->
        <div class="mt-16">
            <h3 class="text-2xl md:text-3xl font-extrabold text-black-900 tracking-tight mb-6">
                Productos propios
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {
                    products.map((p) => (
                        <div class="flex flex-col gap-3 p-6 bg-white border border-black-100 rounded-3xl shadow-sm">
                            <img
                                src={p.image}
                                alt={`Logo de ${p.name}`}
                                loading="lazy"
                                class="w-full aspect-[16/9] object-cover rounded-2xl border border-black-100 mb-1"
                            />
                            <div class="flex flex-wrap items-center gap-3">
                                <span class="text-xl font-bold text-black-900">
                                    {p.name}
                                </span>
                                <span
                                    class={`rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide border ${p.live ? "bg-primary-50 border-primary-100 text-primary-600" : "bg-black-50 border-black-100 text-black-500"}`}
                                >
                                    {p.status}
                                </span>
                            </div>
                            <p class="text-black-600 font-medium">
                                {p.description}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Cierre -->
        <div class="mt-20 flex flex-col items-center gap-6 text-center">
            <h3 class="text-3xl md:text-4xl font-extrabold text-black-900 tracking-tight">
                ¿Qué haríamos en tu negocio?
            </h3>
            <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#128C7E] text-white font-bold text-lg rounded-xl px-8 py-4 transition-colors duration-300 shadow-md hover:shadow-lg"
            >
                <Icons name="whatsapp" />
                Quiero mi diagnóstico gratis
                <ArrowRight class="w-5 h-5" />
            </a>
        </div>
    </div>
</section>
