---
import { Flag, BarChartBig, PencilLine, CheckCircle2 } from "@lucide/astro";
import TimeLineSteps from "./svg/TimeLineSteps.astro";
import TimeLineStepsShadow from "./svg/TimeLineStepsShadow.astro";
import ProcessItem from "./ui/ProcessItem";

export interface IStep {
    number: number;
    title: string;
    description: string;
    icon: any;
    posClass: string;
    posCard: string;
}

const steps: IStep[] = [
    {
        number: 1,
        title: "Diagnóstico gratis",
        description:
            "30 minutos: nos contás cómo funciona hoy tu negocio. Te decimos qué haríamos.",
        icon: Flag,
        posClass: "lg:-bottom-[52px] lg:right-[10px]",
        posCard: "lg:top-[-20px] lg:left-[50px]",
    },
    {
        number: 2,
        title: "Análisis",
        description:
            "Definimos con vos qué hace cada persona y quién ve qué. Lo ves dibujado antes de pagar el desarrollo.",
        icon: BarChartBig,
        posClass: "lg:-top-[70px] lg:right-[30px]",
        posCard: "lg:bottom-[-120px] lg:left-[100px]",
    },
    {
        number: 3,
        title: "Desarrollo por etapas",
        description:
            "Cada pocas semanas te mostramos algo funcionando. Nada de \"esperá tres meses y vemos\".",
        icon: PencilLine,
        posClass: "lg:-bottom-[25px] lg:-right-[0px]",
        posCard: "lg:top-[-60px] lg:left-[100px]",
    },
    {
        number: 4,
        title: "Lanzamiento y soporte",
        description: "Lo ponemos en marcha con tu equipo y seguimos ahí.",
        icon: CheckCircle2,
        posClass: "lg:-top-[34px] lg:right-[10px]",
        posCard: "lg:bottom-[-134px] lg:left-[100px]",
    },
];
---

<section
    id="procesos"
    class="pt-24 lg:pt-48 pb-24 lg:pb-32 bg-black-50 relative overflow-hidden"
>
    <div
        class="absolute right-[-10%] w-[600px] h-[600px] bg-primary-100/90 rounded-full blur-[100px] z-0 pointer-events-none"
    >
    </div>

    <div class="container-labs text-center mb-32 relative z-10">
        <span
            class="text-primary-500 font-bold tracking-widest uppercase text-sm mb-4 block"
            >Cómo trabajamos</span
        >
        <h2 class="section-title text-center">
            Primero entendemos. <span
                class="text-transparent bg-clip-text bg-gradient-to-r from-primary-500 to-blue-600"
                >Después programamos.</span
            >
        </h2>
        <p class="section-subtitle mx-auto text-center">
            Así no pagás por algo que no sabés cómo va a quedar.
        </p>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
        <div
            class="hidden lg:block absolute top-1/2 left-0 w-full h-full -translate-y-1/2 z-10"
        >
            <TimeLineSteps />
        </div>
        <div
            class="hidden lg:block absolute top-[160px] inset-x-0 w-full h-full -translate-y-1/2 translate-x-[80px] -z-30"
        >
            <TimeLineStepsShadow />
        </div>

        <div
            id="process-container"
            class="lg:relative z-20 flex flex-col lg:flex-row lg:justify-between items-start w-full gap-16 lg:gap-0 py-10"
        >
            {
                steps.map((step) => (
                    <div class="process-step opacity-0 flex flex-col items-center gap-6 lg:gap-0 relative w-full max-w-sm mx-auto lg:basis-[23%] lg:max-w-none min-h-[150px]">
                        <ProcessItem client:load step={step}>
                            <step.icon
                                className="w-full h-full"
                                stroke-width={2}
                            />
                        </ProcessItem>
                    </div>
                ))
            }
        </div>
    </div>

    <!-- Aprendimos a los golpes -->
    <div class="container-labs relative z-10 mt-16 lg:mt-56">
        <div class="max-w-3xl mx-auto flex flex-col gap-4 p-8 md:p-10 bg-white border border-primary-100 rounded-[2rem] shadow-sm">
            <span class="text-primary-500 font-bold tracking-widest uppercase text-sm">
                Aprendimos a los golpes
            </span>
            <p class="text-2xl md:text-3xl font-extrabold text-black-900 tracking-tight leading-snug">
                “Una vez tiramos un mes de código por no definir bien el
                producto. Por eso ahora nunca empezamos programando.”
            </p>
            <a
                href="https://www.instagram.com/cetzzlabs"
                target="_blank"
                rel="noopener noreferrer"
                class="w-fit font-bold text-primary-600 hover:underline"
            >
                Mirá la serie "La cagada" en Instagram →
            </a>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        // Animación de la línea SVG continua
        const svgContainers = document.querySelectorAll(".svg-container");

        svgContainers.forEach((svgContainer) => {
            const path = svgContainer.querySelector(
                ".mi-camino",
            ) as SVGPathElement;

            if (!path) return;

            const length = path.getTotalLength();

            gsap.set(path, {
                strokeDasharray: length,
                strokeDashoffset: length,
            });

            gsap.to(path, {
                strokeDashoffset: 0,
                duration: 2.5,
                ease: "power2.inOut",
                scrollTrigger: {
                    trigger: svgContainer,
                    start: "top 80%",
                },
            });
        });

        // Animación escalonada (stagger) para cada paso del proceso
        const processContainer = document.getElementById("process-container");
        if (processContainer) {
            gsap.fromTo(
                ".process-step",
                { opacity: 0, y: 50, scale: 0.9 },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 0.8,
                    stagger: 0.2, // Reducido para que aparezcan más rápido
                    ease: "back.out(1.5)",
                    scrollTrigger: {
                        trigger: processContainer,
                        start: "top 90%",
                    },
                },
            );
        }
    });
</script>
