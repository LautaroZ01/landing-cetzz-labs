---

---

<section
    id="resultados"
    class="pt-28 lg:pt-48 pb-20 lg:pb-24 bg-black-50 relative isolate -mt-8 lg:-mt-24 overflow-hidden border-b border-black-100"
>
    <!-- Decorative background elements -->
    <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[400px] bg-gradient-to-b from-black-50 to-transparent rounded-b-full pointer-events-none z-0"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="text-center mb-16">
            <span
                class="text-primary-500 font-bold tracking-widest uppercase text-sm mb-4 block"
                >Resultados de clientes</span
            >
            <h2 class="section-title text-center">
                Números de clientes, <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary-500 to-blue-600"
                    >no promesas</span
                >
            </h2>
            <p class="section-subtitle mx-auto text-center">
                Salen de las cuentas publicitarias de cada cliente.
            </p>
        </div>

        <div
            class="results-container grid grid-cols-1 md:grid-cols-3 gap-8 w-full max-w-5xl mx-auto"
        >
            {/* Metric 1 */}
            <div
                class="result-card opacity-0 translate-y-8 flex flex-col items-center justify-center p-8 bg-white border border-black-100 rounded-3xl shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-br from-primary-50/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                >
                </div>
                <div
                    class="flex items-center text-5xl lg:text-6xl font-black text-black-900 tracking-tighter mb-2"
                >
                    <span class="counter" data-target="20.8" data-decimals="1"
                        >0</span
                    ><span class="text-primary-500">x</span>
                </div>
                <h3 class="text-lg font-bold text-black-900 mb-1">
                    de retorno en anuncios
                </h3>
                <p class="text-center text-black-500 text-sm font-medium">
                    Anitrendy: cada $1 en anuncios trajo $20,8 en ventas.
                </p>
            </div>

            {/* Metric 2 */}
            <div
                class="result-card opacity-0 translate-y-8 flex flex-col items-center justify-center p-8 bg-white border border-black-100 rounded-3xl shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-br from-blue-50/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                >
                </div>
                <div
                    class="flex items-center text-5xl lg:text-6xl font-black text-black-900 tracking-tighter mb-2"
                >
                    <span class="counter" data-target="19">0</span><span
                        class="text-blue-500">x</span
                    >
                </div>
                <h3 class="text-lg font-bold text-black-900 mb-1">
                    veces más barata cada venta
                </h3>
                <p class="text-center text-black-500 text-sm font-medium">
                    Anitrendy: de $51.286 a $2.723 por compra.
                </p>
            </div>

            {/* Metric 3 */}
            <div
                class="result-card opacity-0 translate-y-8 flex flex-col items-center justify-center p-8 bg-white border border-black-100 rounded-3xl shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-br from-cyan-50/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                >
                </div>
                <div
                    class="flex items-center text-5xl lg:text-6xl font-black text-black-900 tracking-tighter mb-2"
                >
                    <span class="text-cyan-500">+</span><span
                        class="counter"
                        data-target="4500">0</span
                    >
                </div>
                <h3 class="text-lg font-bold text-black-900 mb-1">
                    consultas por WhatsApp
                </h3>
                <p class="text-center text-black-500 text-sm font-medium">
                    Implantes Salud: conversaciones iniciadas con Meta Ads, jun–nov 2026.
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    /* Brillo que sigue al cursor sobre cada tarjeta (efecto 3D) */
    .result-card {
        transform-style: preserve-3d;
    }
    .card-glare {
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
        opacity: 0;
        border-radius: inherit;
        transition: opacity 0.35s ease;
        background: radial-gradient(
            circle at var(--gx, 50%) var(--gy, 50%),
            rgba(59, 130, 246, 0.2),
            rgba(59, 130, 246, 0) 55%
        );
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const container = document.querySelector(".results-container");

        if (container) {
            // Animar la aparición de las tarjetas
            gsap.to(".result-card", {
                y: 0,
                opacity: 1,
                duration: 0.8,
                stagger: 0.2,
                ease: "back.out(1.2)",
                scrollTrigger: {
                    trigger: container,
                    start: "top 80%",
                },
            });

            // Animar el conteo numérico
            const counters = document.querySelectorAll(".counter");
            counters.forEach((counter) => {
                const target = parseFloat(
                    counter.getAttribute("data-target") || "0",
                );
                const decimals = parseInt(
                    counter.getAttribute("data-decimals") || "0",
                    10,
                );
                const fmt = new Intl.NumberFormat("es-AR", {
                    minimumFractionDigits: decimals,
                    maximumFractionDigits: decimals,
                });
                const state = { value: 0 };

                gsap.to(state, {
                    value: target,
                    duration: 2.5,
                    ease: "power3.out",
                    onUpdate: () => {
                        counter.textContent = fmt.format(state.value);
                    },
                    scrollTrigger: {
                        trigger: container,
                        start: "top 75%",
                    },
                });
            });
        }

        /* ---- Hover 3D: la tarjeta se inclina siguiendo el mouse ---- */
        const finePointer = window.matchMedia(
            "(hover: hover) and (pointer: fine)",
        ).matches;
        const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        if (finePointer && !reduceMotion) {
            const MAX_TILT = 9;
            const cards =
                document.querySelectorAll<HTMLElement>(".result-card");

            cards.forEach((card) => {
                const glare = document.createElement("div");
                glare.className = "card-glare";
                card.appendChild(glare);

                let rect: DOMRect | null = null;
                const tiltX = gsap.quickTo(card, "rotationX", {
                    duration: 0.4,
                    ease: "power2.out",
                });
                const tiltY = gsap.quickTo(card, "rotationY", {
                    duration: 0.4,
                    ease: "power2.out",
                });

                card.addEventListener("pointerenter", () => {
                    rect = card.getBoundingClientRect();
                    gsap.set(card, {
                        transformPerspective: 900,
                        transformOrigin: "center",
                    });
                    glare.style.opacity = "1";
                });

                card.addEventListener("pointermove", (e) => {
                    if (!rect) rect = card.getBoundingClientRect();
                    const px = (e.clientX - rect.left) / rect.width;
                    const py = (e.clientY - rect.top) / rect.height;
                    tiltY((px - 0.5) * 2 * MAX_TILT);
                    tiltX((0.5 - py) * 2 * MAX_TILT);
                    card.style.setProperty("--gx", `${px * 100}%`);
                    card.style.setProperty("--gy", `${py * 100}%`);
                });

                card.addEventListener("pointerleave", () => {
                    rect = null;
                    glare.style.opacity = "0";
                    gsap.to(card, {
                        rotationX: 0,
                        rotationY: 0,
                        duration: 0.6,
                        ease: "power3.out",
                    });
                });
            });
        }
    });
</script>
