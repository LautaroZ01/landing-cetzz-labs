---
/* Fotos reales del equipo en la oficina. Si la lista queda vacía se muestra el video. */
const teamPhotos: { src: string; alt: string }[] = [
    { src: "/team/oficina-1.webp", alt: "Alguien del equipo de CetZz Labs programando en la oficina" },
    { src: "/team/oficina-2.webp", alt: "El equipo de CetZz Labs trabajando junto en la oficina" },
];
---

<section
    id="quienes-somos"
    class="relative z-[2] py-20 lg:py-60 bg-primary-100 overflow-hidden border-t border-primary-100 rounded-[2rem] lg:rounded-[6rem]"
>
    <div
        class="about-stage max-w-7xl mx-auto px-6 grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-16 items-center relative z-10"
    >
        <div
            class={`about-video relative w-full flex justify-center items-center opacity-0 lg:-ml-6 ${teamPhotos.length > 0 ? "" : "aspect-square md:aspect-[4/3]"}`}
        >
            {teamPhotos.length > 0 ? (
                <div class={`grid items-center gap-3 sm:gap-5 w-full mx-auto ${teamPhotos.length > 1 ? "grid-cols-2 max-w-[26rem] sm:max-w-[34rem] lg:max-w-[34rem]" : "grid-cols-1 max-w-[16rem] sm:max-w-[20rem]"}`}>
                    {teamPhotos.slice(0, 2).map((photo, i) => (
                        <img
                            src={photo.src}
                            alt={photo.alt}
                            loading="lazy"
                            class={`w-full min-w-0 aspect-[9/16] object-cover rounded-[1.5rem] lg:rounded-[2rem] shadow-2xl shadow-primary-900/10 ring-1 ring-black-100 ${teamPhotos.length > 1 ? (i === 1 ? "mt-8 lg:mt-12" : "mb-8 lg:mb-12") : ""}`}
                        />
                    ))}
                </div>
            ) : (
            <div
                class="relative w-full h-full rounded-[2rem] lg:rounded-[3rem] overflow-hidden bg-primary-950 shadow-2xl shadow-primary-900/10 ring-1 ring-black-100 flex items-center justify-center p-1 lg:p-2"
            >
                <video
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-cover rounded-[1.8rem] lg:rounded-[2.8rem] scale-[1.01]"
                >
                    <source src="/hero-video.mp4" type="video/mp4" />
                </video>
                <div
                    class="absolute inset-0 rounded-[2rem] lg:rounded-[3rem] ring-1 ring-inset ring-white/10 pointer-events-none"
                >
                </div>
                <div
                    class="absolute inset-0 bg-gradient-to-t from-primary-950/40 via-transparent to-transparent pointer-events-none rounded-[2rem] lg:rounded-[3rem]"
                >
                </div>
            </div>
            )}
        </div>

        <div class="flex flex-col gap-8 items-start">
            <h2 class="about-text section-title opacity-0 text-left">
                Un mismo equipo <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary-500 to-blue-600"
                    >de 6 en Salta.</span
                >
            </h2>

            <div
                class="about-text flex flex-col gap-4 text-lg text-black-600 leading-relaxed font-normal opacity-0"
            >
                <p>
                    <strong class="text-black-900 font-bold"
                        >Dos en estrategia y negocio, cuatro en desarrollo.</strong
                    > Más de un año trabajando juntos, para todo el país.
                </p>
                <p>
                    Seguinos en Instagram:
                    <a
                        href="https://www.instagram.com/cetzzlabs"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-bold text-primary-600 hover:underline"
                        >@cetzzlabs</a
                    >
                </p>
            </div>

            <!-- Contadores Originales Restaurados -->
            <div
                class="about-text grid grid-cols-2 gap-4 sm:gap-6 w-full pt-8 mt-2 border-t border-primary-200 relative opacity-0"
            >
                <div
                    class="flex flex-col gap-1 pl-4 border-l-[3px] border-primary-500 bg-white/50 p-4 rounded-r-2xl"
                >
                    <span
                        class="text-4xl lg:text-5xl font-black text-black-900 tracking-tighter flex items-center"
                    >
                        <span class="counter-about-1">0</span>
                    </span>
                    <span
                        class="text-black-700 text-xs sm:text-sm font-extrabold uppercase tracking-wide"
                        >Personas en el equipo</span
                    >
                </div>
                <div
                    class="flex flex-col gap-1 pl-4 border-l-[3px] border-blue-500 bg-white/50 p-4 rounded-r-2xl"
                >
                    <span
                        class="text-4xl lg:text-5xl font-black text-black-900 tracking-tighter flex items-center"
                    >
                        <span class="text-blue-500">+</span><span
                            class="counter-about-2">0</span
                        >
                    </span>
                    <span
                        class="text-black-700 text-xs sm:text-sm font-extrabold uppercase tracking-wide"
                        >Año trabajando juntos</span
                    >
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { ScrollToPlugin } from "gsap/ScrollToPlugin";

    gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

    document.addEventListener("DOMContentLoaded", () => {
        const section = document.getElementById("quienes-somos");

        if (section) {
            const reduceMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            if (reduceMotion) {
                gsap.set(".about-video, .about-text", { autoAlpha: 1 });
            } else {
                /* Enfoque distinto al del Hero (que es un "alejamiento" atado
                   al scroll): acá es un despliegue 3D DISPARADO por umbral y
                   REVERSIBLE, que se arma al entrar y se pliega al salir. */
                const tl = gsap.timeline({
                    defaults: { ease: "power3.out" },
                    scrollTrigger: {
                        trigger: section,
                        start: "top 75%",
                        toggleActions: "play none none reverse",
                    },
                });

                tl.fromTo(
                    ".about-video",
                    {
                        autoAlpha: 0,
                        xPercent: -6,
                        rotationY: 16,
                        transformOrigin: "left center",
                    },
                    {
                        autoAlpha: 1,
                        xPercent: 0,
                        rotationY: 0,
                        transformPerspective: 900,
                        duration: 1,
                    },
                ).fromTo(
                    ".about-text",
                    {
                        autoAlpha: 0,
                        y: 60,
                        rotationX: -50,
                        transformOrigin: "50% 0%",
                    },
                    {
                        autoAlpha: 1,
                        y: 0,
                        rotationX: 0,
                        transformPerspective: 900,
                        duration: 0.8,
                        stagger: 0.16,
                        ease: "back.out(1.5)",
                    },
                    "-=0.55",
                );
            }

            /* ---- Transición ENTRE secciones (overlap tipo "stack") ----
               El solape lo hace el CSS: Testimonios y Nosotros son
               `position: sticky; top: 0` dentro de .section-stack, así que
               Nosotros se interpone sobre Testimonios y Servicios sube por
               encima de Nosotros. GSAP acá sólo agrega la profundidad:
               la sección que queda debajo retrocede (se achica y se atenúa)
               mientras la de arriba la va tapando. */
            if (!reduceMotion) {
                const recede = {
                    scale: 0.92,
                    autoAlpha: 0.35,
                    yPercent: -4,
                    transformOrigin: "center top",
                    ease: "none",
                };

                const prevStage = document.querySelector(".testi-stage");
                if (prevStage) {
                    gsap.to(prevStage, {
                        ...recede,
                        scrollTrigger: {
                            trigger: section,
                            start: "top bottom",
                            end: "top top",
                            scrub: 0.6,
                        },
                    });
                }

                /* Transición "catapulta": al pasar por la mitad de "Nosotros"
                   scrolleando hacia abajo, te lleva rápido a la sección siguiente
                   (nada de solape lento). Enfoque totalmente distinto al de
                   Testimonios → Nosotros. */
                const nextSection = document.getElementById("problemas");
                const isDesktop =
                    window.matchMedia("(min-width: 1024px)").matches;
                if (nextSection && isDesktop) {
                    let jumpLock = false;

                    ScrollTrigger.create({
                        trigger: section,
                        start: "center center",
                        onEnter: () => {
                            if (jumpLock) return;
                            jumpLock = true;
                            gsap.to(window, {
                                scrollTo: { y: nextSection, autoKill: false },
                                duration: 0.55,
                                ease: "power2.inOut",
                                onComplete: () => {
                                    window.setTimeout(
                                        () => (jumpLock = false),
                                        500,
                                    );
                                },
                            });
                        },
                        onLeaveBack: () => {
                            jumpLock = true;
                            window.setTimeout(() => (jumpLock = false), 800);
                        },
                    });
                }
            }

            // Animación de contadores de About
            const aboutCounters = [
                { selector: ".counter-about-1", endValue: 6 },
                { selector: ".counter-about-2", endValue: 1 },
            ];

            aboutCounters.forEach((item) => {
                const el = document.querySelector(item.selector);
                if (el) {
                    gsap.to(el, {
                        innerHTML: item.endValue,
                        duration: 2.5,
                        snap: { innerHTML: 1 },
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: section,
                            start: "top 60%",
                        },
                    });
                }
            });
        }
    });
</script>
