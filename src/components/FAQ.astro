---
import { ChevronDown } from "@lucide/astro";

const faqs = [
    {
        question: "¿Cuánto cuesta?",
        answer: "Depende de lo que necesites. Después del diagnóstico te pasamos un presupuesto cerrado, por etapas."
    },
    {
        question: "¿Cuánto tarda?",
        answer: "Una web simple, entre 1 y 2 semanas. Un sistema a medida, entre 3 y 6 semanas según el alcance. En el presupuesto va cada etapa con su fecha."
    },
    {
        question: "¿No me sirve un sistema genérico más barato?",
        answer: "Muchas veces sí: si recién arrancás o trabajás de forma estándar, uno genérico alcanza y sale menos. A medida conviene cuando ya probaste uno y terminaste igual con planillas, cuando pagás por funciones que no usás, o cuando necesitás que el local, la tienda online y el WhatsApp se hablen entre sí."
    },
    {
        question: "¿Y si después quiero cambiar algo?",
        answer: "Después del lanzamiento seguimos con soporte y vamos sumando mejoras."
    },
    {
        question: "¿Trabajan fuera de Salta?",
        answer: "Sí. Todo el país, 100% online."
    }
];
---

<section id="faq" class="py-24 lg:py-32 bg-black-50 relative overflow-hidden">
    <div class="max-w-3xl mx-auto px-6 relative z-10">
        <div class="text-center mb-16">
            <span class="text-primary-500 font-bold tracking-widest uppercase text-sm mb-4 block">Preguntas frecuentes</span>
            <h2 class="section-title text-center">
                Lo que todos <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-500 to-blue-600">preguntan antes.</span>
            </h2>
        </div>

        <div class="flex flex-col gap-4">
            {faqs.map((faq, index) => (
                <div class="faq-item bg-white border border-black-100 rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-md">
                    <button class="faq-button w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 cursor-pointer">
                        <span class="text-black-900 font-bold text-lg pr-4">{faq.question}</span>
                        <ChevronDown class="w-5 h-5 text-primary-500 transition-transform duration-300 faq-icon flex-shrink-0" />
                    </button>
                    <div class="faq-content overflow-hidden max-h-0 transition-all duration-300 ease-in-out">
                        <div class="px-6 pb-6 text-black-600 font-medium leading-relaxed">
                            <p>{faq.answer}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const faqItems = document.querySelectorAll('.faq-item');
        
        faqItems.forEach(item => {
            const button = item.querySelector('.faq-button');
            const content = item.querySelector('.faq-content') as HTMLElement;
            const icon = item.querySelector('.faq-icon');
            
            if (button && content && icon) {
                button.addEventListener('click', () => {
                    const isOpen = item.classList.contains('is-open');
                    
                    // Close all others
                    faqItems.forEach(otherItem => {
                        if (otherItem !== item && otherItem.classList.contains('is-open')) {
                            otherItem.classList.remove('is-open');
                            const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
                            const otherIcon = otherItem.querySelector('.faq-icon');
                            if (otherContent) otherContent.style.maxHeight = '0px';
                            if (otherIcon) otherIcon.classList.remove('rotate-180');
                            otherItem.classList.remove('border-primary-200', 'shadow-lg');
                            otherItem.classList.add('border-black-100');
                        }
                    });
                    
                    // Toggle current
                    if (isOpen) {
                        item.classList.remove('is-open');
                        content.style.maxHeight = '0px';
                        icon.classList.remove('rotate-180');
                        item.classList.remove('border-primary-200', 'shadow-lg');
                        item.classList.add('border-black-100');
                    } else {
                        item.classList.add('is-open');
                        content.style.maxHeight = content.scrollHeight + 'px';
                        icon.classList.add('rotate-180');
                        item.classList.remove('border-black-100');
                        item.classList.add('border-primary-200', 'shadow-lg');
                    }
                });
            }
        });
    });
</script>
